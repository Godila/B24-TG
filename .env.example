# Telegram (MTProto)
TG_API_ID=12345
TG_API_HASH=your_api_hash_from_my_telegram_org
TG_SESSIONS_DIR=/data/tg_sessions
# Прокси для MTProto: нужен, если хостинг блокирует подсети Telegram
# (типично для РФ-хостингов). Схема: socks5|socks4|http; пусто = напрямую.
TG_PROXY_SCHEME=
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# Bitrix24 OAuth
B24_PORTAL=https://your-portal.bitrix24.ru
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Секрет для проверки webhook ONAPPINSTALL (X-Webhook-Secret)
B24_WEBHOOK_SECRET=
# Публичный адрес приложения (https://…): подписанные URL медиа и handler-ы
# коннектора открытых линий. Пусто = файлы в открытые линии не отправляются.
PUBLIC_BASE_URL=

# Throttling
THROTTLE_INIT_MAX=10
THROTTLE_INIT_WINDOW=180
THROTTLE_INIT_MIN_INTERVAL=5
THROTTLE_REPLY_MAX=20

# Web / UI
SESSION_SECRET=change-me-to-a-long-random-string
DEV_MODE=false
# Разрешённые CORS-origins через запятую; пусто = CORS отключён (только same-origin).
# Для прод: https://<портал>.bitrix24.ru,https://<домен>
CORS_ORIGINS=
STATIC_DIR=src/app/static

# Инфра
DATABASE_URL=postgresql+asyncpg://bitrix_tg:devpass@postgres:5432/bitrix_tg

# Outbox
OUTBOX_POLL_INTERVAL=2
OUTBOX_MAX_ATTEMPTS=5

# Алерты: b24_user_id админа для уведомлений о TG-сессиях в B24-чат
ALERT_ADMIN_B24_USER_ID=1
